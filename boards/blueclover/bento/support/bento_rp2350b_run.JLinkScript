/*
 * JLink script for post-flash run of RP2350B on Bento1.
 *
 * Overrides ResetTarget with a pin-toggle so the RP2350 bootrom runs freely
 * without the debugger halting it before handoff to the application.
 * Used as the second step after flashing (flash with normal script, run with this one).
 */

int ResetTarget(void) {
  JTAG_ResetPin = 0;
  JLINK_SYS_Sleep(50);
  JTAG_ResetPin = 1;
  JLINK_SYS_Sleep(200);
  return 0;
}
