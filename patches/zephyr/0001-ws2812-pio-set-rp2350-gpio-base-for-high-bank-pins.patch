@@ -173,6 +193,18 @@ static int ws2812_rpi_pico_pio_init(const struct device *dev)
 
 	pio = pio_rpi_pico_get_pio(config->piodev);
 
+#if defined(CONFIG_SOC_SERIES_RP2350)
+	/*
+	 * The RP2350 PIO can only address a 32-pin window selected by GPIOBASE
+	 * (0 -> GPIO 0-31, 16 -> GPIO 16-47). It must be set before loading the
+	 * PIO program (the SDK rejects pio_set_gpio_base() once instruction
+	 * memory is non-empty). config->gpio_base is computed at build time from
+	 * the data pin: 16 reaches high-bank pins like GPIO36 (Bento1) / GPIO43
+	 * (PER-401); 0 keeps low-bank pins like GPIO14 (Bento2) addressable.
+	 */
+	pio_set_gpio_base(pio, config->gpio_base);
+#endif
+
 	pio_add_program(pio, &config->program);
 
