@@ -182,6 +214,20 @@ static int ws2812_rpi_pico_pio_init(const struct device *dev)
 	(DT_PROP_BY_IDX(node, bit_waveform, 0) + DT_PROP_BY_IDX(node, bit_waveform, 1) +           \
 	 DT_PROP_BY_IDX(node, bit_waveform, 2))
 
+/* Port offset added to the controller-relative pin to get the absolute GPIO. */
+#define WS2812_PORT_OFFSET(node) (DT_REG_ADDR(DT_GPIO_CTLR_BY_IDX(node, gpios, 0)) * 32)
+
+/* Absolute GPIO number of the strip data pin. */
+#define WS2812_ABS_GPIO_PIN(node) (WS2812_PORT_OFFSET(node) + DT_GPIO_PIN_BY_IDX(node, gpios, 0))
+
+/*
+ * RP2350 PIO GPIOBASE window origin for the strip data pin: 16 if the pin is
+ * in the high bank (>= 32, e.g. GPIO36/GPIO43), else 0. The child strip node
+ * is named "ws2812" on these boards.
+ */
+#define WS2812_PIO_GPIO_BASE(inst)                                                                  \
+	(WS2812_ABS_GPIO_PIN(DT_INST_CHILD(inst, ws2812)) >= 32 ? 16 : 0)
+
 #define WS2812_CHILD_INIT(node)                                                                    \
