 		usbd_msg_pub_device(uds_ctx, USBD_MSG_CDC_ACM_LINE_CODING, dev);
 		return 0;
 
-	case SET_CONTROL_LINE_STATE:
+	case SET_CONTROL_LINE_STATE: {
+		const bool dtr_was_set = data->line_state_dtr;
+
 		data->line_state = setup->wValue;
 		cdc_acm_update_linestate(data);
+
+		/*
+		 * A rising DTR edge means a host program has just opened the
+		 * port. Use it to recover a wedged data path.
+		 *
+		 * If the controller abandons the bulk IN endpoint (on the
+		 * RP2350 this is reported via SIE_STATUS.ENDPOINT_ERROR, with
+		 * the failing endpoint identified in EP_TX_ERROR), no transfer
+		 * completion is ever raised again. CDC_ACM_TX_FIFO_BUSY stays
+		 * set, the TX handler returns early forever, and the port is
+		 * dead until the device is physically reset -- reopening the
+		 * host-side port does not help, because nothing on this side
+		 * re-arms the endpoint.
+		 *
+		 * Recovering here is safe and self-limiting: it is driven by a
+		 * real host action rather than a timeout (so it cannot fire
+		 * during a healthy idle period), it does not touch enumeration
+		 * (so it cannot cause the device to drop off the bus), and
+		 * re-arming an endpoint that is already healthy is a no-op.
+		 */
+		if (!dtr_was_set && data->line_state_dtr) {
+			cdc_acm_reset_data_path(c_data, dev);
+		}
+
 		usbd_msg_pub_device(uds_ctx, USBD_MSG_CDC_ACM_CONTROL_LINE_STATE, dev);
 		return 0;
+	}
 
