+/*
+ * Restart the bulk data path after the controller has abandoned an endpoint.
+ *
+ * Called on a rising DTR edge (see SET_CONTROL_LINE_STATE). Flushes whatever
+ * the controller still holds on the bulk endpoints, drops the class-level
+ * in-flight flags that a lost completion would otherwise leave set forever, and
+ * restarts both directions.
+ *
+ * Ordering matters: udc_ep_dequeue() releases the controller's claimed buffers
+ * and generates the corresponding request events, so the busy bits are cleared
+ * *after* it returns, otherwise those events would race with this reset and
+ * leave the flags set again.
+ */
+/*
+ * Diagnostic accessor for the CDC-ACM TX path.
+ *
+ * The class driver's state is private, so from outside there is no way to tell
+ * a stalled controller from a class driver that is not submitting work. This
+ * exposes the two facts that distinguish them: how many bytes are still waiting
+ * in the TX FIFO, and whether the class believes a transfer is in flight.
+ *
+ * Local addition for the USB shell wedge investigation; not upstream API.
+ */
+int usbd_cdc_acm_tx_diag(const struct device *dev, uint32_t *pending, bool *busy)
+{
+	struct cdc_acm_uart_data *const data = dev->data;
+
+	if (data == NULL) {
+		return -EINVAL;
+	}
+
+	*pending = ring_buf_size_get(data->tx_fifo.rb);
+	*busy = atomic_test_bit(&data->state, CDC_ACM_TX_FIFO_BUSY);
+
+	return 0;
+}
+
+static void cdc_acm_reset_data_path(struct usbd_class_data *const c_data,
+				    const struct device *dev)
+{
+	struct usbd_context *uds_ctx = usbd_class_get_ctx(c_data);
+	struct cdc_acm_uart_data *const data = dev->data;
+
+	if (!atomic_test_bit(&data->state, CDC_ACM_CLASS_ENABLED)) {
+		return;
+	}
+
+	LOG_DBG("DTR asserted, restarting bulk data path");
+
+	(void)udc_ep_dequeue(uds_ctx->dev, cdc_acm_get_bulk_in(c_data));
+	(void)udc_ep_dequeue(uds_ctx->dev, cdc_acm_get_bulk_out(c_data));
+
+	atomic_clear_bit(&data->state, CDC_ACM_TX_FIFO_BUSY);
+	atomic_clear_bit(&data->state, CDC_ACM_RX_FIFO_BUSY);
+
+	/*
+	 * Re-prime reception, and kick the TX handler so anything still sitting
+	 * in the TX FIFO is sent rather than stranded. Both are no-ops when the
+	 * path is already healthy.
+	 */
+	if (atomic_test_bit(&data->state, CDC_ACM_IRQ_RX_ENABLED)) {
+		cdc_acm_work_submit(&data->rx_fifo_work);
+	}
+
+	cdc_acm_work_schedule(&data->tx_fifo_work, K_NO_WAIT);
+}
