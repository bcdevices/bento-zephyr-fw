-	net_buf_add_mem(buf, ep_data->buf, MIN(len, net_buf_tailroom(buf)));
+	len = MIN(len, net_buf_tailroom(buf));
+	/* Read from DPRAM with aligned 32-bit accesses (see rpi_pico_dpram_read). */
+	rpi_pico_dpram_read(net_buf_add(buf, len), ep_data->buf, len);
 
 	if (net_buf_tailroom(buf) && len == udc_mps_ep_size(ep_cfg)) {
 		__unused int err;
@@ -676,6 +903,7 @@ static void rpi_pico_isr_handler(const struct device *dev)
 	usb_hw_t *base = config->base;
 	uint32_t status = base->ints;
 	uint32_t handled = 0;
+	bool error_seen = false;
 
 	if (status & USB_INTS_DEV_SOF_BITS) {
 		handled |= USB_INTS_DEV_SOF_BITS;
@@ -693,6 +921,7 @@ static void rpi_pico_isr_handler(const struct device *dev)
 		if (pcfg != NULL && !(sie_status & USB_SIE_STATUS_CONNECTED_BITS) &&
 		    !(sie_status & USB_SIE_STATUS_VBUS_DETECTED_BITS)) {
 			sie_dp_pullup(dev, false);
+			udc_rpi_pico_err_stats.vbus_removed++;
 			udc_submit_event(dev, UDC_EVT_VBUS_REMOVED, 0);
 		}
 
@@ -742,6 +971,7 @@ static void rpi_pico_isr_handler(const struct device *dev)
 		sie_status_clr(dev, USB_SIE_STATUS_SUSPENDED_BITS);
 
 		udc_set_suspended(dev, true);
+		udc_rpi_pico_err_stats.suspends++;
 		udc_submit_event(dev, UDC_EVT_SUSPEND, 0);
 	}
 
@@ -750,50 +980,282 @@ static void rpi_pico_isr_handler(const struct device *dev)
 		sie_status_clr(dev, USB_SIE_STATUS_BUS_RESET_BITS);
 
 		sys_write32(0, (mm_reg_t)&base->dev_addr_ctrl);
+		udc_rpi_pico_err_stats.bus_resets++;
 		udc_submit_event(dev, UDC_EVT_RESET, 0);
 	}
 
+	/*
+	 * Line-level bus errors (CRC, bit-stuff, data-sequence, RX timeout).
+	 *
+	 * On the RP2350 these fire in a continuous storm when the device sits
+	 * behind a USB hub (including the internal hub on many host ports): the
+	 * SIE misreports the hub's split-transaction PRE/preamble tokens as CRC /
+	 * bit-stuff / data-sequence / RX-timeout errors, and its single shared
+	 * handshake-status latch can also surface a genuine completion as one of
+	 * these. The device otherwise communicates normally.
+	 *
+	 * The stock driver submits a UDC_EVT_ERROR for each one, which floods the
+	 * usbd core thread under sustained traffic and starves the data path.
+	 * Here we treat these four as benign: clear the SIE status latch and note
+	 * that an error occurred so the buffer-status register is re-checked
+	 * below (a completion may be latched there with its BUFF_STATUS interrupt
+	 * lost to the shared-latch quirk). No error event is raised.
+	 *
+	 * RX_OVERFLOW is a genuine buffer overrun, distinct from these line
+	 * errors, and is still surfaced as an error event.
+	 */
 	if (status & USB_INTS_ERROR_DATA_SEQ_BITS) {
 		handled |= USB_INTS_ERROR_DATA_SEQ_BITS;
 		sie_status_clr(dev, USB_SIE_STATUS_DATA_SEQ_ERROR_BITS);
-		/*
-		 * This can be triggered before the STALL handshake response
-		 * to the OUT DATAx. Handling IRQ_ON_STALL to fix the expected
-		 * DATA PID is too much overhead since the endpoint is halted
-		 * anyway.
-		 */
-		LOG_WRN("Data Sequence Error");
+		udc_rpi_pico_err_stats.data_seq++;
+		error_seen = true;
 	}
 
 	if (status & USB_INTS_ERROR_RX_TIMEOUT_BITS) {
 		handled |= USB_INTS_ERROR_RX_TIMEOUT_BITS;
 		sie_status_clr(dev, USB_SIE_STATUS_RX_TIMEOUT_BITS);
+		udc_rpi_pico_err_stats.rx_timeout++;
+		error_seen = true;
+	}
 
-		LOG_ERR("RX timeout");
-		udc_submit_event(dev, UDC_EVT_ERROR, -EINVAL);
+	if (status & USB_INTS_ERROR_BIT_STUFF_BITS) {
+		handled |= USB_INTS_ERROR_BIT_STUFF_BITS;
+		sie_status_clr(dev, USB_SIE_STATUS_BIT_STUFF_ERROR_BITS);
+		udc_rpi_pico_err_stats.bit_stuff++;
+		error_seen = true;
+	}
+
+	if (status & USB_INTS_ERROR_CRC_BITS) {
+		handled |= USB_INTS_ERROR_CRC_BITS;
+		sie_status_clr(dev, USB_SIE_STATUS_CRC_ERROR_BITS);
+		udc_rpi_pico_err_stats.crc++;
+		error_seen = true;
+	}
+
+	/*
+	 * Endpoint-level errors.
+	 *
+	 * SIE_STATUS.ENDPOINT_ERROR reports that an endpoint's transmit or
+	 * receive path failed; EP_TX_ERROR / EP_RX_ERROR hold a saturating
+	 * 2-bit error count per endpoint. The stock driver enables neither the
+	 * interrupt nor reads these registers, so a failing data endpoint is
+	 * never noticed: the SIE stops servicing it, the class driver's
+	 * transfer never completes, no completion interrupt is raised, and
+	 * every thread goes idle believing its work is done. Output stops
+	 * permanently with no error anywhere in software.
+	 *
+	 * Clear the latches (all write-clear) so the counters stay meaningful,
+	 * record what happened, and surface a single error event so the usbd
+	 * core and class drivers can reset their state rather than waiting
+	 * forever on a transfer the hardware has already abandoned.
+	 */
+	/*
+	 * Re-read the error registers rather than relying solely on the `status`
+	 * snapshot taken at ISR entry: an endpoint error asserted after that read
+	 * would otherwise be missed here and, because INTS.ENDPOINT_ERROR is
+	 * sourced from the (now still-set) SIE_STATUS latch, would not
+	 * necessarily raise a fresh interrupt either. Checking the counters
+	 * directly makes the handler edge-independent.
+	 */
+	if ((status & USB_INTS_ENDPOINT_ERROR_BITS) ||
+	    sys_read32((mm_reg_t)&base->ep_tx_error) ||
+	    sys_read32((mm_reg_t)&base->ep_rx_error)) {
+		uint32_t tx_err = sys_read32((mm_reg_t)&base->ep_tx_error);
+		uint32_t rx_err = sys_read32((mm_reg_t)&base->ep_rx_error);
+
+		handled |= (status & USB_INTS_ENDPOINT_ERROR_BITS);
+
+		/* Write-1-to-clear: writing the value read resets those counts. */
+		if (tx_err) {
+			sys_write32(tx_err, (mm_reg_t)&base->ep_tx_error);
+			udc_rpi_pico_err_stats.ep_tx_errors++;
+			udc_rpi_pico_err_stats.last_ep_tx_error = tx_err;
+		}
+
+		if (rx_err) {
+			sys_write32(rx_err, (mm_reg_t)&base->ep_rx_error);
+			udc_rpi_pico_err_stats.ep_rx_errors++;
+			udc_rpi_pico_err_stats.last_ep_rx_error = rx_err;
+		}
+
+		sie_status_clr(dev, USB_SIE_STATUS_ENDPOINT_ERROR_BITS);
+
+		LOG_ERR("Endpoint error: tx 0x%08x rx 0x%08x", tx_err, rx_err);
+
+		/*
+		 * Escalation: force re-enumeration when per-endpoint recovery
+		 * stops making progress.
+		 *
+		 * Re-arming the endpoint (below) is the right first response,
+		 * but it cannot help when the transactions themselves keep
+		 * failing on the wire: the endpoint is restarted, the next
+		 * transfer fails identically, and the loop runs until the host
+		 * stops polling the device altogether. At that point the link is
+		 * dead and nothing in the device will ever revive it -- observed
+		 * as a wedged shell with the SIE error counters frozen and the
+		 * bus silent.
+		 *
+		 * Dropping the D+ pullup makes the host see a disconnect; the
+		 * host then re-enumerates from scratch, which rebuilds the
+		 * endpoint state on both sides. This does not repair whatever is
+		 * corrupting the transfers, but it turns a permanent wedge into
+		 * a recoverable interruption.
+		 */
+		priv->ep_ok_run = 0;
+
+		/*
+		 * Escalation disabled (limit 0 == off).
+		 *
+		 * Forcing a re-enumeration on a persistently failing endpoint
+		 * made things worse in practice: with errors arriving in the
+		 * dozens per session the device disconnected itself repeatedly,
+		 * so the host could never finish enumerating and the port
+		 * churned continuously instead of settling. The endpoint re-arm
+		 * below is retained -- it is bounded and does not disturb the
+		 * connection -- but tearing down the link is too blunt a
+		 * response to an error rate this high.
+		 */
+		if (RPI_PICO_EP_ERR_REENUM_LIMIT != 0 &&
+		    ++priv->ep_err_run >= RPI_PICO_EP_ERR_REENUM_LIMIT) {
+			priv->ep_err_run = 0;
+			udc_rpi_pico_err_stats.reenumerations++;
+			LOG_ERR("Endpoint error persists; forcing re-enumeration");
+
+			sie_dp_pullup(dev, false);
+			/*
+			 * The host needs to see SE0 for longer than its
+			 * disconnect-detect time (~2.5 us minimum; use a wide
+			 * margin). This runs in ISR context, so it must be a
+			 * busy-wait rather than a sleep -- it is bounded and
+			 * only happens on a link that is already broken.
+			 */
+			k_busy_wait(20000);
+			sie_dp_pullup(dev, true);
+		}
+
+		/*
+		 * Clearing the latches reports the failure but does not restart
+		 * the endpoint: the SIE has abandoned the transfer, so its
+		 * buffer-available bit stays clear, no completion is ever
+		 * raised, and the endpoint's busy flag stays set forever. The
+		 * class driver then waits on a transfer that can never finish.
+		 *
+		 * Re-arm every endpoint the hardware flagged. EP_TX_ERROR /
+		 * EP_RX_ERROR pack a 2-bit count per endpoint, EP n occupying
+		 * bits 2n+1:2n, so a non-zero field identifies the endpoint
+		 * directly. Cancel the stale hardware transfer (which also
+		 * clears the busy flag), then requeue whatever is still at the
+		 * head of that endpoint's queue.
+		 */
+		for (unsigned int i = 0; i < USB_NUM_ENDPOINTS; i++) {
+			const uint32_t field = BIT(2 * i) | BIT(2 * i + 1);
+
+			if (i == 0) {
+				/* EP0 has its own error handling in ch9. */
+				continue;
+			}
+
+			/*
+			 * TX (IN) errors are recorded but NOT retried here.
+			 *
+			 * EP_TX_ERROR reports TRANSACTION, not SEQ: the
+			 * hardware is not claiming a PID mismatch, and a failed
+			 * IN transaction carries no information about whether
+			 * the host received and ACKed the data. Nothing in
+			 * device-side state can distinguish the two, so any
+			 * retry is a guess.
+			 *
+			 * Both guesses were measured and both made things
+			 * worse. Rolling the toggle back raised the error rate
+			 * from ~5/s to ~8/s and introduced fresh SEQ errors.
+			 * Re-preparing the head-of-queue buffer runs
+			 * prep_tx() again -- which advances next_pid on every
+			 * call -- so an 82-deep retry loop simply walked the
+			 * toggle further out of step.
+			 *
+			 * Contrast the OUT path below, where the dedicated SEQ
+			 * bit states unambiguously that the toggle is wrong and
+			 * the correction is determinate. Diagnosing the IN path
+			 * needs the host's view (a protocol analyser or usbmon
+			 * capture), not more device-side inference.
+			 */
+
+			if (rx_err & field) {
+				uint8_t ep = USB_EP_DIR_OUT | i;
+				struct udc_ep_config *cfg = udc_get_ep_cfg(dev, ep);
+
+				if (cfg != NULL && cfg->stat.enabled) {
+					/*
+					 * A SEQ error means the host sent a PID
+					 * we were not armed for: our toggle is
+					 * wrong. prep_rx() advances next_pid
+					 * every time it arms the endpoint, so
+					 * simply re-arming here would keep
+					 * re-applying the same wrong value and
+					 * advancing past it -- the recovery
+					 * loop then sustains the desync it is
+					 * meant to clear (observed: 38 SEQ
+					 * errors, no recovery).
+					 *
+					 * Undo that advance so the re-arm uses
+					 * the PID the host is actually sending.
+					 * Only done for SEQ, where the hardware
+					 * states unambiguously that the toggle
+					 * is wrong; TRANSACTION errors carry no
+					 * such implication.
+					 */
+					if (rx_err & BIT(2 * i + 1)) {
+						get_ep_data(dev, ep)->next_pid ^= 1U;
+					}
+
+					rpi_pico_ep_cancel(dev, ep);
+					rpi_pico_handle_xfer_next(dev, cfg);
+				}
+			}
