+/*
+ * Consecutive endpoint errors, with no successful transfer in between, before
+ * the driver forces a re-enumeration. Sized well above the handful of errors a
+ * transient glitch produces, so a link that recovers on its own never triggers
+ * it, but far below the point where the host gives up on the device.
+ */
+/*
+ * Deliberately low. The host does not keep retrying a failing endpoint
+ * indefinitely -- in practice it abandons the device after roughly a dozen
+ * failed transactions and the bus goes silent, at which point no further
+ * endpoint errors are generated and any higher threshold can never be reached.
+ * The escalation therefore has to trigger while the host is still talking.
+ */
+#define RPI_PICO_EP_ERR_REENUM_LIMIT 0
+
+/*
+ * Consecutive successful IN transfers required before the endpoint-error run is
+ * considered broken. Must be greater than 1: the re-arm on an endpoint error
+ * produces a completion of its own, so a threshold of 1 would clear the run on
+ * every failure and the escalation could never trigger.
+ */
+#define RPI_PICO_EP_OK_RUN_CLEAR 8
+
+/*
+ * Number of consecutive suppressed line errors with no completion behind them
+ * before a real error event is raised. Hub-artifact storms come with genuine
+ * completions latched in buf_status and so never reach this; a transfer truly
+ * lost on the wire produces an unbroken run and does.
+ */
+#define RPI_PICO_EMPTY_ERR_LIMIT 8
+
+/*
+ * SIE error and lifecycle counters.
+ *
+ * The ISR clears the line-error latches to keep a hub-artifact storm from
+ * flooding the usbd core, which also throws away the only per-type record of
+ * what the PHY is seeing. These counters keep that record.
+ *
+ * They exist to answer one question: when the USB endpoint wedges, is the
+ * physical layer degrading first? CRC and bit-stuff errors are produced by the
+ * SIE itself and cannot be caused by firmware timing, so a climbing crc /
+ * bit_stuff count before a wedge indicates an electrical problem (rail
+ * disturbance, missing CC termination, backpowering) that no firmware change
+ * can fix. Counts that stay at zero while the controller stops point the other
+ * way -- at firmware or controller state.
+ *
+ * enable_calls / bus_resets track whether udc_rpi_pico_enable() re-runs: it
+ * memset()s the whole register block (clearing INTE), so a second call that
+ * does not complete leaves interrupts permanently disabled with completions
+ * stranded in BUFF_STATUS.
+ *
+ * Deliberately a plain global, not per-instance: it must be readable from
+ * application code (a diagnostic thread) without a device handle, and there is
+ * exactly one USB device controller on this SoC.
+ */
+struct udc_rpi_pico_err_stats {
+	uint32_t crc;
+	uint32_t bit_stuff;
+	uint32_t data_seq;
+	uint32_t rx_timeout;
+	uint32_t rx_overflow;
+	uint32_t enable_calls;
+	uint32_t bus_resets;
+	uint32_t suspends;
+	uint32_t vbus_removed;
+	/* Endpoint-level errors, and the raw register value most recently seen
+	 * (2 bits per endpoint, EP n at bits 2n+1:2n).
+	 */
+	uint32_t ep_tx_errors;
+	uint32_t ep_rx_errors;
+	uint32_t last_ep_tx_error;
+	uint32_t last_ep_rx_error;
+	/* Forced re-enumerations after unrecoverable endpoint errors. */
+	uint32_t reenumerations;
+	/* Endpoints halted after a controller error, and host CLEAR_FEATURE
+	 * responses that cleared them. If halts climb but clears stay at zero,
+	 * the host is not performing the standard resynchronisation.
+	 */
+	uint32_t ep_halts;
+	uint32_t ep_halt_clears;
+	/* Address of the most recently halted / cleared endpoint. */
+	uint8_t last_halted_ep;
+	uint8_t last_cleared_ep;
+};
+
+struct udc_rpi_pico_err_stats udc_rpi_pico_err_stats;
