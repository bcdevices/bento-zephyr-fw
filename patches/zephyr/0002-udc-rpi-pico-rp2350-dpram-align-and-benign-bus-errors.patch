+/*
+ * Halt an endpoint the controller has reported as broken, so that the host
+ * resynchronises it through the standard USB mechanism.
+ *
+ * Background: prep_tx()/prep_rx() advance the DATA0/DATA1 toggle when a
+ * transfer is *queued*, not when it completes. A packet lost to a CRC error
+ * therefore leaves the device one toggle ahead of the host. Every subsequent
+ * packet then looks to the host like a retransmission of one it has already
+ * accepted, so it discards the payload and ACKs -- the device sees ACKs and
+ * believes all is well while no data reaches the host. Only something that
+ * resets next_pid recovers, and the only paths that do are device reset and
+ * udc_rpi_pico_ep_clear_halt().
+ *
+ * The host will not initiate that recovery on its own: from its side nothing
+ * looks wrong, because duplicate-PID packets are a normal, silently-discarded
+ * occurrence. The desynchronisation is invisible to the only party able to
+ * clear it.
+ *
+ * Halting the endpoint makes it visible. A STALL handshake obliges the host to
+ * issue CLEAR_FEATURE(ENDPOINT_HALT), which lands in ep_clear_halt() and resets
+ * next_pid to 0 on this side while the host resets its own -- both ends
+ * deterministically back in step, by protocol.
+ *
+ * Deliberately no toggle arithmetic here. An earlier attempt rolled next_pid
+ * back directly on error and made things worse (endpoint error rate ~5/s ->
+ * ~8/s, with new SEQ and DATA_SEQ errors): EP_TX_ERROR is a saturating count,
+ * not a per-attempt flag, so it cannot distinguish a packet the host never
+ * received from one it received and ACKed with only the handshake corrupted.
+ * Guessing wrong desynchronises further. Handing the problem to the host's
+ * clear-halt path avoids having to guess at all.
+ */
+/*
+ * NOTE: endpoint STALL as a resynchronisation mechanism was tried here and
+ * REVERTED. Recording the result so it is not attempted again.
+ *
+ * The idea: udc_rpi_pico_ep_clear_halt() is the only non-reset path that resets
+ * next_pid, so halting a desynchronised endpoint should oblige the host to send
+ * CLEAR_FEATURE(ENDPOINT_HALT) and resynchronise both ends by protocol.
+ *
+ * Measured on target: the handshake worked exactly as intended -- the host
+ * issued ten CLEAR_FEATUREs against the halted endpoint -- and the interface
+ * stayed dead throughout. A data-toggle desynchronisation would have been
+ * repaired by the first one. The wedge therefore is NOT a toggle desync.
+ *
+ * The same run also recorded crc=4 / ep_tx_errors=2, against 133 / 119 in
+ * earlier wedged runs, so the failure is not a function of bus error rate
+ * either.
+ */
+
 static void rpi_pico_handle_xfer_next(const struct device *dev,
 				      struct udc_ep_config *const cfg)
 {
@@ -593,6 +801,23 @@ static void rpi_pico_handle_buff_status_in(const struct device *dev, const uint8
 		return;
 	}
 
+	/*
+	 * Count consecutive good IN transfers. The error run is only cleared
+	 * once the link has strung several together.
+	 *
+	 * Resetting on a single completion is not enough: the endpoint re-arm
+	 * performed on an endpoint error itself produces a completion, which
+	 * would clear the run every time and make the escalation below
+	 * unreachable (observed as an endpoint erroring 65 times with the
+	 * re-enumeration never firing). A link that is genuinely working
+	 * produces an uninterrupted stream of completions, so requiring a few
+	 * in a row distinguishes recovery from a failure that merely bounced.
+	 */
+	if (++priv->ep_ok_run >= RPI_PICO_EP_OK_RUN_CLEAR) {
+		priv->ep_ok_run = RPI_PICO_EP_OK_RUN_CLEAR;
+		priv->ep_err_run = 0;
+	}
+
 	len = read_buf_ctrl_reg(dev, ep) & USB_BUF_CTRL_LEN_MASK;
 	net_buf_pull(buf, len);
 
