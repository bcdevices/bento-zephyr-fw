 #include <zephyr/logging/log.h>
 LOG_MODULE_REGISTER(udc_rpi_pico, CONFIG_UDC_DRIVER_LOG_LEVEL);
 
+/*
+ * The USB dual-port RAM (DPRAM) only tolerates naturally-aligned accesses.
+ * Some libc memcpy() implementations issue unaligned word accesses, which on
+ * the RP2350 Cortex-M33 core raise a UsageFault when the target is DPRAM (the
+ * Hazard3 core happens to tolerate them, which is why this only bites on the
+ * M33 build). Copy through 32-bit accesses on the DPRAM side, byte-assembling
+ * the RAM side which may itself be unaligned.
+ *
+ * See zephyr issue #96993 (CDC-ACM UsageFault in rpi_pico_prep_tx on RP2350).
+ */
+static void rpi_pico_dpram_write(void *dpram_dst, const void *src, size_t len)
+{
+	volatile uint32_t *d = dpram_dst;
+	const uint8_t *s = src;
+
+	while (len >= sizeof(uint32_t)) {
+		uint32_t w = (uint32_t)s[0] | ((uint32_t)s[1] << 8) |
+			     ((uint32_t)s[2] << 16) | ((uint32_t)s[3] << 24);
+		*d++ = w;
+		s += sizeof(uint32_t);
+		len -= sizeof(uint32_t);
+	}
+
+	if (len) {
+		uint32_t w = 0;
+
+		for (size_t i = 0; i < len; i++) {
+			w |= (uint32_t)s[i] << (8U * i);
+		}
+		*d = w;
+	}
+}
+
+static void rpi_pico_dpram_read(void *dst, const void *dpram_src, size_t len)
+{
+	const volatile uint32_t *s = dpram_src;
+	uint8_t *d = dst;
+
+	while (len >= sizeof(uint32_t)) {
+		uint32_t w = *s++;
+
+		d[0] = (uint8_t)w;
+		d[1] = (uint8_t)(w >> 8);
+		d[2] = (uint8_t)(w >> 16);
+		d[3] = (uint8_t)(w >> 24);
+		d += sizeof(uint32_t);
+		len -= sizeof(uint32_t);
+	}
+
+	if (len) {
+		uint32_t w = *s;
+
+		for (size_t i = 0; i < len; i++) {
+			d[i] = (uint8_t)(w >> (8U * i));
+		}
+	}
+}
