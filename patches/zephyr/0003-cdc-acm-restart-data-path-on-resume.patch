+	/*
+	 * Any transfer that was in flight when the configuration was torn down
+	 * -- typically by a bus reset -- is cancelled without a completion, so
+	 * the busy flags the completion path would have cleared remain set.
+	 *
+	 * That is fatal for RX: cdc_acm_irq_rx_enable() below, and
+	 * cdc_acm_rx_fifo_handler(), both test-and-set CDC_ACM_RX_FIFO_BUSY, so
+	 * a stale flag makes the re-arm a silent no-op and the endpoint is
+	 * never primed again. The port then accepts no input for the rest of
+	 * the session, which for a shell means no commands and hence no output
+	 * either -- observed as state=0x15 (enabled, irq-rx-en, rx-busy) with
+	 * both FIFOs empty and reception armed 0 times since the reset.
+	 *
+	 * Clear both here: this is a fresh configuration, so by definition
+	 * nothing is in flight.
+	 */
+	atomic_clear_bit(&data->state, CDC_ACM_RX_FIFO_BUSY);
+	atomic_clear_bit(&data->state, CDC_ACM_TX_FIFO_BUSY);
+
