+/*
+ * Event-queue drop diagnostics.
+ *
+ * usbd_msgq is CONFIG_USBD_MAX_UDC_MSG deep (default 10) and this put is
+ * K_NO_WAIT, so on overflow the event is DESTROYED and -ENOMSG returned. Every
+ * caller discards that return: udc_submit_ep_event()/udc_submit_event() pass it
+ * up, and all of the driver's call sites ignore it.
+ *
+ * A dropped UDC_EVT_EP_REQUEST is unrecoverable state corruption, not
+ * backpressure: the completion never reaches the class driver, so nothing
+ * clears CDC_ACM_*_FIFO_BUSY, and every re-arm path is gated on that flag.
+ * The endpoint is dead with no counter anywhere recording why -- which is
+ * exactly the shape of the observed wedges.
+ *
+ * Counted here to establish whether this actually occurs before designing
+ * around it.
+ */
+uint32_t usbd_core_msgq_drops;
+uint32_t usbd_core_msgq_drop_type;
+uint32_t usbd_core_msgq_hiwater;
+
 static int usbd_event_carrier(const struct device *dev,
 			      const struct udc_event *const event)
 {
-	return k_msgq_put(&usbd_msgq, event, K_NO_WAIT);
+	uint32_t used;
+	int ret;
+
+	ret = k_msgq_put(&usbd_msgq, event, K_NO_WAIT);
+	if (ret != 0) {
+		usbd_core_msgq_drops++;
+		usbd_core_msgq_drop_type = (uint32_t)event->type;
+	}
+
+	used = (uint32_t)k_msgq_num_used_get(&usbd_msgq);
+	if (used > usbd_core_msgq_hiwater) {
+		usbd_core_msgq_hiwater = used;
+	}
+
+	return ret;
 }
 
