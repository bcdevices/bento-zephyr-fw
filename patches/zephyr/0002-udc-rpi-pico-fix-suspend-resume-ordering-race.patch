+/*
+ * Keyed on SOF loss, not on RX_TIMEOUT: wedges occur with no RX_TIMEOUT at all.
+ * A host sends a SOF every 1 ms on any live bus, so prolonged silence means it
+ * has stopped servicing us rather than having nothing to send -- which is why
+ * this cannot false-positive on idleness the way a bare timeout would.
+ */
+static bool udc_rpi_pico_link_is_dead(const struct device *dev)
+{
+	struct rpi_pico_data *priv = udc_get_private(dev);
+	uint32_t now = k_uptime_get_32();
+
+	/* Not attached yet, or still enumerating. */
+	if (!priv->sof_seen) {
+		return false;
+	}
+
+	/* A suspended host holds the connection and will resume it. */
+	if (udc_is_suspended(dev)) {
+		return false;
+	}
+
+	return (now - priv->last_sof_time) > RPI_PICO_LINK_DEAD_MS;
+}
+
+/*
+ * Recovery rung 1: ask the host to resume us. At the wedge LINE_STATE reads J
+ * (suspended) rather than SE0 (port disabled), so remote wakeup is the defined
+ * recovery, and unlike a reattach it preserves enumeration.
+ *
+ * Requires CONFIG_CDC_ACM_SERIAL_REMOTE_WAKEUP for the descriptor attribute,
+ * without which the host never enables remote wakeup. If the port is actually
+ * disabled this does nothing and the reattach still fires.
+ */
+static bool udc_rpi_pico_try_wakeup(const struct device *dev)
+{
+	const struct rpi_pico_config *config = dev->config;
+	struct rpi_pico_data *priv = udc_get_private(dev);
+	usb_hw_t *base = config->base;
+
+	/* One attempt: measured across five link deaths, wakeup only ever
+	 * succeeded on the first try, so retrying just delays the reattach.
+	 */
+	priv->recovery_mark_ms = priv->last_sof_time;
+
+	rpi_pico_bit_set((mm_reg_t)&base->sie_ctrl, USB_SIE_CTRL_RESUME_BITS);
+
+	k_msleep(RPI_PICO_WAKEUP_WAIT_MS);
+
+	/* Frames arriving after the mark are what proves the host resumed us. */
+	return priv->last_sof_time != priv->recovery_mark_ms;
+}
+
+static void udc_rpi_pico_force_reattach(const struct device *dev)
+{
+	struct rpi_pico_data *priv = udc_get_private(dev);
+
+	sie_dp_pullup(dev, false);
+	k_msleep(RPI_PICO_REATTACH_MS);
+	sie_dp_pullup(dev, true);
+
+	/* Re-arm the detector, or we would reattach on every poll while the
+	 * host works through enumeration.
+	 */
+	priv->last_sof_time = k_uptime_get_32();
+}
+
+/*
+ * Recovery ladder. Wakeup first since it preserves enumeration; a reattach
+ * always works but tears the port down. Run from the driver thread so recovery
+ * does not depend on the application polling for it.
+ */
+static void rpi_pico_check_link(const struct device *dev)
+{
+	if (!udc_rpi_pico_link_is_dead(dev)) {
+		return;
+	}
+
+	if (udc_rpi_pico_try_wakeup(dev)) {
+		LOG_WRN("link dead, remote wakeup restored frames");
+		return;
+	}
+
+	LOG_WRN("link dead, wakeup failed, forcing re-attach");
+	udc_rpi_pico_force_reattach(dev);
+}
