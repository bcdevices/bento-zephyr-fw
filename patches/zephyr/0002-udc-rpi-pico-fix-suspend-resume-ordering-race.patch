+/*
+ * Reconciliation snapshot: does the cached stat.busy bit agree with what the
+ * controller actually owns?
+ *
+ * stat.busy is a plain remembered bit (udc_common.c) that is never compared
+ * against buf_ctrl.AVAILABLE. If busy is set while AVAILABLE is clear, the
+ * controller has finished with the buffer and the completion was lost -- a
+ * positive, non-idle stuck signal. An OUT endpoint merely waiting for the user
+ * to type still has AVAILABLE SET, so this cannot false-positive on idleness,
+ * which is what the two earlier failed watchdogs did.
+ */
+/*
+ * Has the link died?
+ *
+ * Returns true only on the positive, measured terminal signature: an
+ * RX_TIMEOUT was seen, AND no SOF has arrived since, AND enough time has passed
+ * that the silence cannot be ordinary bus idle.
+ *
+ * All three conditions matter. Requiring the RX_TIMEOUT keeps this from firing
+ * on a host that has legitimately suspended the port, and requiring SOF silence
+ * keeps it from firing on the transient errors a healthy link shrugs off. An
+ * earlier attempt at automatic re-enumeration keyed on a bare timeout fired
+ * during healthy idle periods and churned the port continuously -- strictly
+ * worse than the wedge (see docs/usb-shell-investigation.md section 6). This
+ * cannot do that: on a live bus SOFs arrive every 1 ms, so last_sof_ms is
+ * always fresh and the predicate is false regardless of how many errors occur.
+ */
+bool udc_rpi_pico_link_is_dead(const struct device *dev)
+{
+	uint32_t now = k_uptime_get_32();
+
+	ARG_UNUSED(dev);
+
+	/*
+	 * Keyed on SOF loss alone, not on RX_TIMEOUT.
+	 *
+	 * RX_TIMEOUT is a frequent precursor but NOT universal: wedges occur
+	 * with rx_timeouts=0 and SOFs dead for tens of seconds, and requiring
+	 * it meant the detector never fired on those. Loss of SOF is the
+	 * signal that actually holds in every observed wedge.
+	 *
+	 * This is still a positive signal rather than an idleness heuristic. A
+	 * host sends a SOF every 1 ms on any live bus, whether or not it has
+	 * traffic for us, so silence for RPI_PICO_LINK_DEAD_MS means the host
+	 * has stopped servicing the port entirely -- it is not "nothing to do",
+	 * it is "no longer talking to us".
+	 *
+	 * The one legitimate cause of prolonged SOF silence is a real host
+	 * suspend, which is excluded below: a suspended host holds the
+	 * connection and will resume it, and the driver already tracks that
+	 * state.
+	 */
+	if (udc_rpi_pico_susp_trace.sof_seen == 0) {
+		/* Never ran: not attached yet, or still enumerating. */
+		return false;
+	}
+
+	if (udc_rpi_pico_susp_trace.sw_suspended) {
+		return false;
+	}
+
+	return (now - udc_rpi_pico_susp_trace.last_sof_ms) >
+	       RPI_PICO_LINK_DEAD_MS;
+}
+
+/*
+ * Force the host to re-enumerate us by dropping the D+ pullup briefly.
+ *
+ * Once the host has stopped sending SOFs there is nothing the device can do on
+ * the existing connection -- it holds no timer the host will honour and cannot
+ * initiate traffic. Presenting a disconnect is the one action that provably
+ * makes the host restart: it tears down its endpoint state and re-enumerates,
+ * which runs the full bus-reset path here and rebuilds both sides cleanly.
+ */
+/*
+ * Rung 1 of recovery: ask the host to resume us.
+ *
+ * Measured at every wedge: SIE_STATUS.LINE_STATE = J (idle), not SE0. USB 2.0
+ * distinguishes these -- a *suspended* port idles at J while a hub-*disabled*
+ * port drives SE0 (section 11.5.1.4) -- so the host appears to have suspended
+ * the port rather than disabled it. Remote wakeup is the defined recovery for
+ * exactly that case and, unlike dropping the pullup, it preserves enumeration:
+ * no /dev node churn, no re-configuration, session continuity intact.
+ *
+ * Requires CONFIG_CDC_ACM_SERIAL_REMOTE_WAKEUP so the configuration descriptor
+ * sets bmAttributes bit 5; without it the host never issues
+ * SET_FEATURE(DEVICE_REMOTE_WAKEUP) and usbd_wakeup_request() returns -EACCES.
+ *
+ * Honest caveat: SUSPENDED reads 0 and CONNECTED reads 1 at the wedge, and this
+ * driver already documents the RP2350 SUSPENDED bit as unreliable, so J alone
+ * is suggestive rather than conclusive. If the port is genuinely disabled this
+ * does nothing and the reattach below still fires -- the ladder fails safe.
+ */
+bool udc_rpi_pico_try_wakeup(const struct device *dev)
+{
+	const struct rpi_pico_config *config = dev->config;
+	usb_hw_t *base = config->base;
+
+	/*
+	 * Signal, wait, and retry a few times before giving up.
+	 *
+	 * One attempt, not several. Retrying was tried and measured useless: of
+	 * 13 attempts across five link deaths, the single success came on
+	 * attempt 0, and attempts 1 and 2 never succeeded once
+	 * (wakeup_attempt_hist = 1/0/0). Wakeup either works immediately or not
+	 * at all, so the retry loop only added 450 ms of latency before
+	 * escalating to the reattach that was going to be needed anyway. The
+	 * loop is retained so the histogram keeps recording this, but
+	 * RPI_PICO_WAKEUP_ATTEMPTS is 1.
+	 *
+	 * The window is wider than the original 50 ms: USB 2.0 section 7.1.7.7
+	 * allows the host up to 20 ms of resume signalling, and frames only
+	 * resume after that completes.
+	 */
+	for (int attempt = 0; attempt < RPI_PICO_WAKEUP_ATTEMPTS; attempt++) {
+		udc_rpi_pico_susp_trace.wakeup_tries++;
+
+		rpi_pico_bit_set((mm_reg_t)&base->sie_ctrl,
+				 USB_SIE_CTRL_RESUME_BITS);
+
+		k_msleep(RPI_PICO_WAKEUP_WAIT_MS);
+
+		if (udc_rpi_pico_susp_trace.last_sof_ms >
+		    udc_rpi_pico_susp_trace.wakeup_mark_ms) {
+			udc_rpi_pico_susp_trace.wakeup_ok++;
+			udc_rpi_pico_susp_trace.wakeup_attempt_hist[
+				attempt & 3]++;
+			return true;
+		}
+	}
+
+	return false;
+}
+
+void udc_rpi_pico_force_reattach(const struct device *dev)
+{
+	udc_rpi_pico_susp_trace.reattaches++;
+
+	sie_dp_pullup(dev, false);
+	k_msleep(RPI_PICO_REATTACH_MS);
+	sie_dp_pullup(dev, true);
+
+	/*
+	 * Re-arm the detector. last_sof_ms is stale by definition here, so
+	 * without this the predicate stays true and we would reattach every
+	 * tick while the host works through enumeration.
+	 */
+	udc_rpi_pico_susp_trace.last_sof_ms = k_uptime_get_32();
+}
+
+void udc_rpi_pico_reconcile_snapshot(const struct device *dev)
+{
+	const struct rpi_pico_config *cfgp = dev->config;
+	usb_hw_t *base = cfgp->base;
+	static const uint8_t eps[2] = { 0x01, 0x82 };
+
+	udc_rpi_pico_susp_trace.ep_stall_nak =
+		sys_read32((mm_reg_t)&base->ep_stall_arm);
+	udc_rpi_pico_susp_trace.snap_sie = sys_read32((mm_reg_t)&base->sie_status);
+	udc_rpi_pico_susp_trace.snap_buf_status =
+		sys_read32((mm_reg_t)&base->buf_status);
+	udc_rpi_pico_susp_trace.snap_sof = sys_read32((mm_reg_t)&base->sof_rd);
+
+	for (int i = 0; i < 2; i++) {
+		struct udc_ep_config *cfg = udc_get_ep_cfg(dev, eps[i]);
+		uint32_t bc;
+		bool sw_busy;
+		bool hw_busy;
+
+		if (cfg == NULL) {
+			continue;
+		}
+
+		bc = read_buf_ctrl_reg(dev, eps[i]);
+		sw_busy = udc_ep_is_busy(cfg);
+		hw_busy = (bc & USB_BUF_CTRL_AVAIL) != 0;
+
+		if (i == 0) {
+			udc_rpi_pico_susp_trace.out_bufctrl = bc;
+			udc_rpi_pico_susp_trace.out_epctrl =
+				sys_read32(get_ep_ctrl_reg(dev, eps[i]));
+			udc_rpi_pico_susp_trace.out_halted = cfg->stat.halted;
