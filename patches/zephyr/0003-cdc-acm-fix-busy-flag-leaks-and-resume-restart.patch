@@ -396,6 +497,25 @@ static void usbd_cdc_acm_resumed(struct usbd_class_data *const c_data)
 	struct cdc_acm_uart_data *data = dev->data;
 
 	atomic_clear_bit(&data->state, CDC_ACM_CLASS_SUSPENDED);
+
+	/*
+	 * Restart the data path WITHOUT clearing the busy flags. A suspend
+	 * cancels nothing, so a transfer outstanding across it is still queued
+	 * and completes normally; the flags are accurate. Clearing them arms a
+	 * second transfer while the first is in flight, and the outstanding
+	 * count then ratchets up by one per resume until the buffer pool runs
+	 * dry. Both handlers re-test their own busy bit, so kicking them is
+	 * safe.
+	 */
+	if (atomic_test_bit(&data->state, CDC_ACM_IRQ_RX_ENABLED)) {
+		cdc_acm_irq_rx_enable(dev);
+	}
+
+	if (!atomic_test_bit(&data->state, CDC_ACM_RX_FIFO_BUSY)) {
+		cdc_acm_work_submit(&data->rx_fifo_work);
+	}
