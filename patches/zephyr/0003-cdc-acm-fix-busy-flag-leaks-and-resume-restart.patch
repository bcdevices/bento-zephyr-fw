+	usbd_cdc_acm_tx_enq++;
+	data->tx_claim = buf;
 	ret = usbd_ep_enqueue(c_data, buf);
 	if (ret) {
 		LOG_ERR("Failed to enqueue");
 		net_buf_unref(buf);
+		data->tx_claim = NULL;
 		atomic_clear_bit(&data->state, CDC_ACM_TX_FIFO_BUSY);
+		/*
+		 * Reschedule, as the alloc-failure path above does. Releasing
+		 * the flag alone leaves whatever is still in tx_fifo with no
+		 * work item to send it: the completion re-arm cannot fire
+		 * (nothing is in flight) and the irq_cb re-arm requires
+		 * tx_fifo.altered, which only a fresh fifo_fill sets. An idle
+		 * shell with queued output would stall indefinitely.
+		 */
+		cdc_acm_work_schedule(&data->tx_fifo_work, K_MSEC(1));
 	}
 }
 
