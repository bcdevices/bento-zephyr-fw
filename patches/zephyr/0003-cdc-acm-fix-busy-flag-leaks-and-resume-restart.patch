+/*
+ * Diagnostic accessor for the CDC-ACM wedge investigation. The class driver's
+ * state is private, so from outside there is no way to tell which layer has
+ * stopped. Returns the raw state bitmap; pending/rx report FIFO occupancy.
+ *
+ * state bits: 0 enabled, 1 suspended, 2 irq-rx-en, 3 irq-tx-en,
+ *             4 rx-fifo-busy, 5 tx-fifo-busy
+ */
+int usbd_cdc_acm_diag(const struct device *dev, uint32_t *tx_pending,
+		      uint32_t *rx_pending)
+{
+	struct cdc_acm_uart_data *const data = dev->data;
+
+	*tx_pending = ring_buf_size_get(data->tx_fifo.rb);
+	*rx_pending = ring_buf_size_get(data->rx_fifo.rb);
+
+	return (int)atomic_get(&data->state);
+}
+
 static void usbd_cdc_acm_resumed(struct usbd_class_data *const c_data)
 {
 	const struct device *dev = usbd_class_get_private(c_data);
 	struct cdc_acm_uart_data *data = dev->data;
 
+	usbd_cdc_acm_res_calls++;
 	atomic_clear_bit(&data->state, CDC_ACM_CLASS_SUSPENDED);
+
+	/*
+	 * Restart the data path -- WITHOUT clearing the busy flags.
+	 *
+	 * A suspend does not cancel anything: usbd_core's UDC_EVT_SUSPEND
+	 * handling only updates status and broadcasts, it never dequeues or
+	 * disables an endpoint. A transfer outstanding across a suspend is
+	 * therefore still queued in the controller and completes normally after
+	 * resume, so the busy flags are accurate and must be left alone.
+	 *
+	 * Clearing them here (as an earlier revision did) arms a second
+	 * transfer while the first is still in flight, breaking the
+	 * single-outstanding-transfer invariant. The completion for the first
+	 * then releases the flag belonging to the second, which arms a third,
+	 * and the number of outstanding buffers ratchets up by one per resume.
+	 * Each leak is permanent, and the shared UDC buffer pool eventually
+	 * runs dry. It also skews the enqueue/completion counters by exactly
+	 * one per resume, which reads convincingly like a lost completion.
+	 *
+	 * Both handlers re-test their own busy bit, so simply kicking them is
+	 * safe and is a no-op when a transfer really is in flight.
+	 */
+	if (atomic_test_bit(&data->state, CDC_ACM_IRQ_RX_ENABLED)) {
+		cdc_acm_irq_rx_enable(dev);
+	}
+
+	if (!atomic_test_bit(&data->state, CDC_ACM_RX_FIFO_BUSY)) {
+		cdc_acm_work_submit(&data->rx_fifo_work);
+	}
+
+	cdc_acm_work_schedule(&data->tx_fifo_work, K_NO_WAIT);
 }
 
