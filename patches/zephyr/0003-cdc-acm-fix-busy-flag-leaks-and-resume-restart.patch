 	atomic_clear_bit(&data->state, CDC_ACM_CLASS_ENABLED);
 	atomic_clear_bit(&data->state, CDC_ACM_CLASS_SUSPENDED);
+	/* In-flight transfers are gone with the configuration; drop the busy
+	 * flags so a later enable starts from a clean state.
+	 */
